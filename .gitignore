# ============================================================
# AIMS4PT .gitignore
# ============================================================
.gitignore
# -----------------------------
# Python bytecode / cache
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# C extensions / compiled artifacts
*.so
*.dll
*.dylib

# -----------------------------
# Distribution / packaging
# -----------------------------
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# -----------------------------
# Installer logs
# -----------------------------
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------
# Unit test / coverage reports
# -----------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
nosetests.xml
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -----------------------------
# Environments / local secrets
# -----------------------------
.env
.env.*
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/
conda-meta/

# -----------------------------
# Editors and IDEs
# -----------------------------
.vscode/
.idea/
*.swp
*.swo

# -----------------------------
# Jupyter / local notebook history
# -----------------------------
.ipynb_checkpoints/
.history/

# -----------------------------
# OS generated files
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# Local caches / temporary outputs
# -----------------------------
.cache/
.images/
*.tmp
*.temp
*.log
local_outputs/
outputs/
uploads/
reports/
cache/
logs/
report_output/
figures/tmp/
*.pkl
*.pickle

# Keep official packaged model resources available for versioning.
!src/aims4pt/model_tools/trained_model/**/*.pkl
!src/aims4pt/model_tools/trained_model/**/*.pickle
!src/aims4pt/model_tools/data/**/*.pkl
!src/aims4pt/model_tools/data/**/*.pickle

# -----------------------------
# Data policy
# -----------------------------
# Keep folder structure and documentation, but ignore private/raw/intermediate data.
# Release-ready public datasets can be intentionally versioned under data/release/.
data/raw/
data/interim/
data/processed/
data/external/

!data/README.md
!data/release/
!data/release/.gitkeep

# Old data/example folders from my_analysis_tools; do not migrate by accident.
/files/
/test/

# -----------------------------
# Local non-cpx / non-AIMS4PT model wrappers
# -----------------------------
# Kept locally for private analysis or manuscript comparison only.
# These files are not part of the public AIMS4PT_cpx package and should not be
# imported by the default model registry.
src/aims4pt/model_tools/local_models/eruption_classification.py
src/aims4pt/model_tools/local_models/Gu26.py
src/aims4pt/model_tools/local_models/LandZ24_bt.py
src/aims4pt/model_tools/local_models/Putirka_08_pl.py



/src/aims4pt/data_tools/excel_processor.py
/paper/data/merapi_literature_P.xlsx
/paper/data/merapi_literature_T.xlsx
/paper/data/GEOROC_cpx.csv
memo.md

260422-melt_thermobarometer.ipynb

# -----------------------------
# Archives
# -----------------------------
archive/
notebooks/archive/

# -----------------------------
# Web / frontend artifacts, if the calculator app is added later
# -----------------------------
node_modules/
.next/
.nuxt/
.vercel/
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Official AIMS4PT trained resources are explicitly unignored above.
